<Window x:Class="NovelKeeper.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批評空間から一括取り込み" SizeToContent="Height" Width="440"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="取り込む範囲を選んでください" FontWeight="Bold" Margin="0,0,0,10" />

        <RadioButton x:Name="PlayedOnlyRadio" GroupName="Scope" Margin="0,4">
            <TextBlock TextWrapping="Wrap">プレイ済の作品だけ</TextBlock>
        </RadioButton>
        <RadioButton x:Name="PossessionRadio" GroupName="Scope" Margin="0,4">
            <TextBlock TextWrapping="Wrap">プレイ済 ＋ 所持している作品</TextBlock>
        </RadioButton>
        <RadioButton x:Name="AllRadio" GroupName="Scope" Margin="0,4" IsChecked="True">
            <TextBlock TextWrapping="Wrap">批評空間に登録しているすべての作品<LineBreak />
                <Run Text="（未プレイ・購入予定・放棄なども含む）" />
            </TextBlock>
        </RadioButton>

        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,12,0,12">
            ツールでの状態は、批評空間で「プレイ済」→ プレイ済、「放棄」→ 中断、それ以外 → 未プレイ になります。
            すでに一覧にある作品は追加しません。
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取り込む" Click="Ok_Click" IsDefault="True" FontWeight="Bold" />
            <Button Content="キャンセル" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
