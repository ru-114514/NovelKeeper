<Window x:Class="ErogeLauncher.Views.SessionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プレイ時間の記録" SizeToContent="Height" Width="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="Heading" FontWeight="Bold" Margin="0,0,0,10" />

        <TextBlock Text="日付" />
        <DatePicker x:Name="DatePick" Margin="0,2,0,8" />

        <TextBlock Text="開始時刻（例：20:30）" />
        <TextBox x:Name="TimeBox" Width="80" HorizontalAlignment="Left" Margin="0,2,0,8" />

        <TextBlock Text="プレイ時間" />
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBox x:Name="HoursBox" Width="50" />
            <TextBlock Text="時間" VerticalAlignment="Center" Margin="4,0,12,0" />
            <TextBox x:Name="MinutesBox" Width="50" />
            <TextBlock Text="分" VerticalAlignment="Center" Margin="4,0,0,0" />
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,8,0,0"
                   Text="開始時刻から、入力した時間だけ遊んだ記録として入ります（レポートの時間帯のグラフにも反映されます）。1件で入れられるのは24時間までです。" />

        <TextBlock x:Name="ErrorText" Foreground="#E04040" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Click="Ok_Click" IsDefault="True" FontWeight="Bold" Width="80" />
            <Button Content="キャンセル" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
