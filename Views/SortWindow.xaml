<Window x:Class="NovelKeeper.Views.SortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="並び替え" SizeToContent="Height" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="上の条件から順に並び替えます" Margin="0,0,0,10" />

        <Grid x:Name="KeyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="第1条件" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Key1" Margin="4" />
            <ComboBox Grid.Row="0" Grid.Column="2" x:Name="Dir1" Margin="4" />

            <TextBlock Grid.Row="1" Text="第2条件" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Key2" Margin="4" />
            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="Dir2" Margin="4" />

            <TextBlock Grid.Row="2" Text="第3条件" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Key3" Margin="4" />
            <ComboBox Grid.Row="2" Grid.Column="2" x:Name="Dir3" Margin="4" />
        </Grid>

        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,10,0,12"
                   Text="一覧の見出しをクリックしても並び替えられます。Shift キーを押しながら別の見出しをクリックすると、条件を追加できます。下のプルダウンで設定1〜3に保存すると、一覧の「設定1〜3」ボタンでワンクリックで切り替えられます。" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ComboBox x:Name="PresetBox" Width="190" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="OK を押したときに、いまの条件を設定1〜3に保存します（設定を空にするときは、一覧の設定ボタンの横の「×」を押します）" />
            <Button Content="OK" Click="Ok_Click" IsDefault="True" FontWeight="Bold" Width="80" />
            <Button Content="キャンセル" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
