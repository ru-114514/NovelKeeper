<Window x:Class="ErogeLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovelKeeper ― ノベルゲーム ランチャー" Height="640" Width="1180"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 下部のステータス表示 -->
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="準備完了" />
        </StatusBar>

        <TabControl x:Name="MainTabs" Padding="0">
            <!-- ======================= 一覧タブ ======================= -->
            <TabItem Header="一覧">
                <DockPanel>
                    <!-- 上部のボタン（毎日使う操作）。入りきらない分は右端の ▼ から選ぶ -->
                    <Grid x:Name="ToolBarRoot" DockPanel.Dock="Top" Margin="4,4,4,2" SizeChanged="ToolBarRoot_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ToolItems" Orientation="Horizontal" ClipToBounds="True">
                            <Button Content="▶ 起動" Click="Launch_Click" FontWeight="Bold" />
                            <Button Content="＋ 作品を追加" Click="AddGame_Click" />
                            <Button Content="⇅ 批評空間と同期" Click="Sync_Click" />
                            <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Margin="6,0,2,0">
                                <TextBlock Text="表示:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox x:Name="FilterBox" Width="150" SelectionChanged="FilterBox_SelectionChanged">
                                    <ComboBoxItem Content="すべて" />
                                    <ComboBoxItem Content="未プレイ" />
                                    <ComboBoxItem Content="プレイ中" />
                                    <ComboBoxItem Content="プレイ済" />
                                    <ComboBoxItem Content="中断" />
                                    <ComboBoxItem Content="起動設定が未設定" />
                                    <ComboBoxItem Content="発売前" />
                                    <ComboBoxItem Content="発売後" />
                                    <ComboBoxItem Content="購入前" />
                                    <ComboBoxItem Content="購入確認が必要" />
                                </ComboBox>
                            </StackPanel>
                            <Button Content="⇅ 並び替え…" Click="Sort_Click"
                                    ToolTip="見出しをクリックしても並び替えられます（Shift を押しながらクリックすると条件を追加）" />
                            <Button x:Name="DetailToggleButton" Content="詳細欄を隠す" Click="ToggleDetail_Click" />
                        </StackPanel>
                        <!-- 入りきらないボタンはここから選ぶ（ほかのボタンと同じ文字の大きさ） -->
                        <Button x:Name="MoreButton" Grid.Column="1" Content="▼" Click="MoreButton_Click"
                                ToolTip="入りきらない操作を表示します" Visibility="Collapsed" />
                    </Grid>

                    <!-- 一覧と詳細欄。詳細欄の位置（右／下）と表示・非表示は MainWindow.xaml.cs の ApplyDetailLayout で切り替える -->
                    <Grid>
                        <Grid x:Name="ContentGrid">
                            <!-- 一覧と、その下の左右スライダー -->
                            <DockPanel x:Name="ListPanel">
                                <!-- 左右スライダー：列を左右に動かす（Shift＋マウスホイールでも動かせる） -->
                                <ScrollBar x:Name="ListHScroll" DockPanel.Dock="Bottom" Orientation="Horizontal" Height="16"
                                           SmallChange="40" LargeChange="200" Minimum="0" Maximum="0"
                                           ValueChanged="ListHScroll_ValueChanged"
                                           ToolTip="左右に動かして、隠れている列を表示します（Shift＋マウスホイールでも動きます。Ctrl＋マウスホイールで拡大縮小）" />
                                <!-- 作品一覧（「起動設定」欄のダブルクリックで起動） -->
                                <DataGrid x:Name="GameGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single" HeadersVisibility="Column"
                                          SelectionChanged="GameGrid_SelectionChanged"
                                          PreviewMouseDoubleClick="GameGrid_MouseDoubleClick"
                                          AllowDrop="True" DragOver="GameGrid_DragOver" Drop="GameGrid_Drop"
                                          Sorting="GameGrid_Sorting"
                                          HorizontalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="GameGrid_PreviewMouseWheel"
                                          Loaded="GameGrid_Loaded"
                                      CanUserResizeColumns="True" CanUserReorderColumns="True">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="460" MinWidth="120" />
                                        <DataGridTextColumn Header="ブランド" Binding="{Binding Brand}" Width="180" MinWidth="60" />
                                        <DataGridTextColumn Header="発売日" Binding="{Binding SellDay}" Width="90" />
                                        <DataGridTextColumn Header="中央値" Binding="{Binding Median}" Width="55" />
                                        <DataGridTextColumn Header="得点" Binding="{Binding MyScore}" Width="50" FontWeight="Bold" />
                                        <DataGridTextColumn Header="状態" Binding="{Binding StatusText}" Width="85" SortMemberPath="StatusOrder" />
                                        <DataGridTextColumn Header="購入予定" Binding="{Binding PurchaseWillText}" Width="85" />
                                        <!-- 発売済みなのに所持が付いていない購入予定の作品は、セルを赤く塗る（色は MainWindow.xaml.cs の ApplyCategoryColors） -->
                                        <DataGridTextColumn Header="購入確認" Binding="{Binding PurchaseCheckText}" SortMemberPath="NeedsPurchaseCheck" Width="75" />
                                        <DataGridTextColumn Header="クリア日" Binding="{Binding ClearDateText}" Width="85" SortMemberPath="ClearDate" />
                                        <DataGridTextColumn Header="プレイ時間" Binding="{Binding PlayTimeText}" Width="90" SortMemberPath="TotalSeconds" />
                                        <!-- 批評空間の項目（詳細設定タブの「一覧の列」で表示を切り替える。初期状態は非表示） -->
                                        <DataGridTextColumn Header="購入額" Binding="{Binding PriceText}" SortMemberPath="Price" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="平均値" Binding="{Binding EgsAverage}" Width="55" />
                                        <DataGridTextColumn Header="データ数" Binding="{Binding EgsCount}" Width="65" />
                                        <DataGridTextColumn Header="所持" Binding="{Binding PossessionText}" Width="50" />
                                        <DataGridTextColumn Header="批評空間ID" Binding="{Binding EgsId}" Width="80" />
                                        <DataGridTextColumn Header="総プレイ時間" Binding="{Binding TotalPlayTimeHours}" Width="90" />
                                        <DataGridTextColumn Header="面白さが分かるまで" Binding="{Binding FunTimeHours}" Width="120" />
                                        <DataGridTextColumn Header="おかず" Binding="{Binding OkazuText}" Width="120" />
                                        <DataGridTextColumn Header="購入前得点" Binding="{Binding BeforeScore}" Width="80" />
                                        <DataGridTextColumn Header="開始日" Binding="{Binding StartDateText}" Width="85" SortMemberPath="StartDate" />
                                        <DataGridTextColumn Header="platform" Binding="{Binding PlatformText}" Width="120" />
                                        <DataGridTextColumn Header="動作状況" Binding="{Binding OperationText}" Width="110" />
                                        <DataGridTextColumn Header="詳細状況" Binding="{Binding PlatformMemoHead}" Width="160" />
                                        <DataGridTextColumn Header="一言感想" Binding="{Binding Hitokoto}" Width="200" />
                                        <DataGridTextColumn Header="長文感想" Binding="{Binding MemoHead}" Width="240" />
                                        <DataGridTextColumn Header="ネタバレ" Binding="{Binding NetabareText}" Width="70" />
                                        <!-- 起動設定：未設定の作品は、ここにショートカットや exe をドロップして設定する -->
                                        <DataGridTemplateColumn Header="起動設定" Width="180" SortMemberPath="IsLaunchUnset">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <!-- 左：起動設定（未設定は黄色、設定済みは緑）／右：▼（色を付けない。起動するものを選び替える） -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid>
                                                        <!-- 未設定：ここにドロップ -->
                                                        <Border Padding="4,1" CornerRadius="3" BorderThickness="1" BorderBrush="#E0A000" Background="#33E0A000"
                                                                ToolTip="ゲーム起動設定で自動設定できない場合、&#10;ショートカットアイコンをドロップすることで設定可能。">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLaunchUnset}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="⬇ ここにドロップ" />
                                                        </Border>
                                                        <!-- 設定済み：緑。ダブルクリックで起動（▼ か右クリックで、起動するもの（収録作など）を選び替えられる） -->
                                                        <!-- 管理者権限で起動する作品は、紫 -->
                                                        <Border Padding="4,1" CornerRadius="3" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#3FC456" />
                                                                    <Setter Property="Background" Value="#333FC456" />
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="ToolTip" Value="通常権限で起動。&#10;右の ▼ で起動ファイル変更可能。" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RunsAsAdmin}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#9B59D0" />
                                                                            <Setter Property="Background" Value="#339B59D0" />
                                                                            <Setter Property="ToolTip" Value="管理者権限で起動。&#10;※ユーザーアカウント制御画面で「はい」を選択。&#10;※右クリックで権限設定変更可能。" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsLaunchUnset}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding LaunchText}" TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>
                                                        <Button Grid.Column="1" Content="▼" Padding="5,0" Margin="3,0,0,0" MinHeight="0" MinWidth="0"
                                                                VerticalAlignment="Stretch" Click="RowTargetMenu_Click" Cursor="Arrow"
                                                                IsEnabled="{Binding IsLaunchSet}"
                                                                ToolTip="起動するファイルを選択。&#10;追加・編集は詳細欄の起動ファイル設定項目で可能。" />
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <!-- 一覧と詳細欄の境目（ドラッグで大きさを変える） -->
                            <GridSplitter x:Name="DetailSplitter" Background="#30808080" ShowsPreview="False"
                                          DragCompleted="DetailSplitter_DragCompleted" />

                            <!-- 選択中の作品の詳細 -->
                            <Border x:Name="DetailBorder" BorderBrush="#40808080">
                                <DockPanel>
                                    <!-- 見出し：ここをドラッグすると、詳細欄を右／下に移動できる -->
                                    <Border x:Name="DetailHeader" DockPanel.Dock="Top" Background="#18808080" Padding="10,4"
                                            Cursor="SizeAll" ToolTip="ドラッグして、右・下、または好きな場所（別ウィンドウ）に移動できます"
                                            PreviewMouseLeftButtonDown="DetailHeader_PreviewMouseLeftButtonDown"
                                            MouseMove="DetailHeader_MouseMove"
                                            QueryContinueDrag="DetailHeader_QueryContinueDrag">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Click="HideDetail_Click" Cursor="Arrow"
                                                    ToolTip="詳細欄を隠す（上部の「詳細欄を表示」ボタンで再表示）" Padding="8,0" />
                                            <Button DockPanel.Dock="Right" x:Name="MoveDetailButton" Content="⤓ 下へ" Cursor="Arrow"
                                                    Click="ToggleDetailPosition_Click" Padding="8,0" />
                                            <TextBlock Text="⠿ 作品の詳細" VerticalAlignment="Center" FontWeight="Bold" />
                                        </DockPanel>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8">
                                        <!-- 右に置くと縦1列、下に置くと横に並ぶ（幅に合わせて折り返す） -->
                                        <WrapPanel x:Name="DetailPanel" IsEnabled="False" Orientation="Horizontal">

                                            <!-- ① 作品と起動するもの（収録作ごとに、いくつでも登録できる） -->
                                            <StackPanel Width="290" Margin="0,0,24,12">
                                                <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <!-- 作品の画像（批評空間の作品情報から取得して、PCに保存しておく） -->
                                                <Image x:Name="DetailImage" MaxHeight="260" MaxWidth="290" Stretch="Uniform"
                                                       HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed" />
                                                <TextBlock x:Name="DetailImageInfo" Opacity="0.6" FontSize="11" Margin="0,0,0,8" Visibility="Collapsed" />
                                                <!-- 管理者権限で起動する作品のときだけ表示（一覧の紫と同じ） -->
                                                <Border x:Name="AdminBadge" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="8,1"
                                                        CornerRadius="3" BorderThickness="1" BorderBrush="#9B59D0" Background="#339B59D0"
                                                        ToolTip="この作品は管理者権限で起動します（Windows の確認画面が出ます）。変えるときは、一覧の「起動設定」欄を右クリックします">
                                                    <TextBlock Text="🛡 管理者権限で起動します" FontSize="12" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="起動ファイル設定" />
                                                <TextBlock Text="ファイルをここにドラッグして追加できます。名前・ファイル・監視の欄はダブルクリックで編集。"
                                                           TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,0,0,2" />
                                                <DataGrid x:Name="TargetGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                          HeadersVisibility="Column" SelectionMode="Single" Height="150" Margin="0,2,0,4"
                                                          AllowDrop="True" PreviewDragOver="TargetGrid_PreviewDragOver" PreviewDrop="TargetGrid_PreviewDrop"
                                                          CellEditEnding="TargetGrid_CellEditEnding"
                                                          HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="" Binding="{Binding CurrentMark}" IsReadOnly="True" Width="24" />
                                                        <DataGridTextColumn Header="名前" Binding="{Binding Label, UpdateSourceTrigger=LostFocus}" Width="100" />
                                                        <DataGridTextColumn Header="ファイル" Binding="{Binding Path, UpdateSourceTrigger=LostFocus}" Width="220" />
                                                        <DataGridTextColumn Header="監視" Binding="{Binding MonitorProcess, UpdateSourceTrigger=LostFocus}" Width="90" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <WrapPanel>
                                                    <Button Content="▶ これを使う" Click="UseTarget_Click" FontWeight="Bold"
                                                            ToolTip="選んだものを、一覧の「起動設定」と「▶ 起動」で使うようにします" />
                                                    <Button Content="＋ 追加…" Click="AddTargetFiles_Click" ToolTip="ファイルを選んで追加します（複数選択できます）" />
                                                    <Button Content="↑" Click="MoveTargetUp_Click" ToolTip="上へ" />
                                                    <Button Content="↓" Click="MoveTargetDown_Click" ToolTip="下へ" />
                                                    <Button Content="削除" Click="DeleteTarget_Click" />
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- ② 記録（批評空間の得点登録フォームの項目） -->
                                            <StackPanel Width="290" Margin="0,0,24,12">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="記録" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <Border x:Name="UnreleasedBadge" Visibility="Collapsed" Margin="10,0,0,0" Padding="8,1" CornerRadius="3"
                                                            Background="#F2A33A" VerticalAlignment="Center"
                                                            ToolTip="発売日がまだ先の作品です">
                                                        <TextBlock Text="発売前の作品" FontSize="12" FontWeight="Bold" Foreground="#2B1B00" />
                                                    </Border>
                                                </StackPanel>
                                                <WrapPanel>
                                                    <CheckBox x:Name="PlayedCheck" Content="プレイ済" FontWeight="Bold"
                                                              Checked="PlayedCheck_Changed" Unchecked="PlayedCheck_Changed" />
                                                    <CheckBox x:Name="PossessionCheck" Content="所持" Margin="20,0,0,0" IsThreeState="False" />
                                                </WrapPanel>
                                                <TextBlock Text="状態（プレイ済でないとき）" Margin="0,8,0,0" />
                                                <ComboBox x:Name="StatusBox" Margin="0,2,0,0">
                                                    <ComboBoxItem Content="未プレイ" />
                                                    <ComboBoxItem Content="プレイ中" />
                                                    <ComboBoxItem Content="中断（批評空間の「放棄」）" />
                                                </ComboBox>
                                                <TextBlock Text="自分の得点（0～100、空欄なら未入力）" Margin="0,8,0,0" />
                                                <TextBox x:Name="ScoreBox" Margin="0,2,0,0" Width="80" HorizontalAlignment="Left" />
                                                <TextBlock Text="ゲーム開始日" Margin="0,8,0,0" />
                                                <DockPanel Margin="0,2,0,0">
                                                    <Button DockPanel.Dock="Right" Content="初回起動日" Click="FillStartDate_Click"
                                                            ToolTip="プレイ時間の記録から、初めて起動した日を入れます" />
                                                    <DatePicker x:Name="StartDatePicker" />
                                                </DockPanel>
                                                <TextBlock Text="ゲーム終了日（クリア日）" Margin="0,8,0,0" />
                                                <DatePicker x:Name="ClearDatePicker" Margin="0,2,0,0" />

                                                <Expander x:Name="ExpPlay" Tag="play" Header="プレイ時間・購入" Margin="0,12,0,0"
                                                          Expanded="DetailExpander_Changed" Collapsed="DetailExpander_Changed">
                                                    <StackPanel Margin="4,4,0,0">
                                                        <TextBlock Text="総プレイ時間（時間）" />
                                                        <DockPanel Margin="0,2,0,0">
                                                            <Button DockPanel.Dock="Right" Content="計測時間を入れる" Click="FillTotalTime_Click"
                                                                    ToolTip="このツールで計測したプレイ時間（時間単位に四捨五入）を入れます" />
                                                            <TextBox x:Name="TotalPlayTimeBox" />
                                                        </DockPanel>
                                                        <Button Content="計測した記録を補正…" Click="EditPlayTime_Click" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                ToolTip="計測し忘れた分の追加や、まちがった記録の修正・削除ができます" />
                                                        <TextBlock Text="面白さが分かるまでのプレイ時間（時間）" Margin="0,8,0,0" />
                                                        <TextBox x:Name="FunTimeBox" Width="80" HorizontalAlignment="Left" Margin="0,2,0,0" />
                                                        <TextBlock Text="おかずに使えた?" Margin="0,8,0,0" />
                                                        <ComboBox x:Name="OkazuBox" Margin="0,2,0,0" />
                                                        <TextBlock Text="購入予定" Margin="0,8,0,0" />
                                                        <ComboBox x:Name="PurchaseWillBox" Margin="0,2,0,0" />
                                                        <TextBlock Text="購入前得点（0～100）" Margin="0,8,0,0" />
                                                        <TextBox x:Name="BeforeScoreBox" Width="80" HorizontalAlignment="Left" Margin="0,2,0,0" />
                                                        <TextBlock Text="購入額（円・任意）" Margin="0,8,0,0"
                                                                   ToolTip="このツールだけに保存します（批評空間には送りません）。空欄なら未入力です" />
                                                        <TextBox x:Name="PriceBox" Width="100" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                                 TextChanged="PriceBox_TextChanged" InputMethod.IsInputMethodEnabled="False"
                                                                 ToolTip="このツールだけに保存します（批評空間には送りません）。空欄なら未入力です" />
                                                    </StackPanel>
                                                </Expander>

                                                <Expander x:Name="ExpPlatform" Tag="platform" Header="動作環境" Margin="0,8,0,0"
                                                          Expanded="DetailExpander_Changed" Collapsed="DetailExpander_Changed">
                                                    <StackPanel Margin="4,4,0,0">
                                                        <TextBlock Text="platform" />
                                                        <ComboBox x:Name="PlatformBox" Margin="0,2,0,0" />
                                                        <TextBlock Text="動作状況" Margin="0,8,0,0" />
                                                        <ComboBox x:Name="OperationBox" Margin="0,2,0,0" />
                                                        <TextBlock Text="詳細状況" Margin="0,8,0,0" />
                                                        <TextBox x:Name="PlatformMemoBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                                                 VerticalScrollBarVisibility="Auto" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Expander>

                                                <Expander x:Name="ExpReview" Tag="review" Header="感想" Margin="0,8,0,0"
                                                          Expanded="DetailExpander_Changed" Collapsed="DetailExpander_Changed">
                                                    <StackPanel Margin="4,4,0,0">
                                                        <TextBlock Text="一言感想" />
                                                        <TextBox x:Name="HitokotoBox" Margin="0,2,0,0" />
                                                        <CheckBox x:Name="SageCheck" Content="トップページに表示しない" Margin="0,4,0,0" />
                                                        <TextBlock Text="長文感想" Margin="0,8,0,0" />
                                                        <TextBox x:Name="MemoBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" Height="200"
                                                                 VerticalScrollBarVisibility="Auto" Margin="0,2,0,0" />
                                                        <CheckBox x:Name="NetabareCheck" Margin="0,4,0,0">
                                                            <TextBlock TextWrapping="Wrap" Text="ネタバレ（チェックが入っているとネタバレ感想となります）" />
                                                        </CheckBox>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>

                                            <!-- ③ 保存と操作 -->
                                            <StackPanel Width="290" Margin="0,0,24,12">
                                                <CheckBox x:Name="PushOnSaveCheck" Content="保存時に批評空間へ反映する" IsChecked="True" Margin="0,0,0,8" />
                                                <Button Content="保存" Click="Save_Click" FontWeight="Bold" HorizontalAlignment="Stretch" />
                                                <TextBlock x:Name="DetailInfo" Margin="0,12,0,8" TextWrapping="Wrap" Opacity="0.7" />
                                                <Button x:Name="DiscardPendingButton" Content="未反映の変更を破棄" Click="DiscardPending_Click" HorizontalAlignment="Stretch"
                                                        Visibility="Collapsed"
                                                        ToolTip="ツールで変更して、まだ批評空間に反映していない内容を捨てます。次の同期で、批評空間の内容を取り込みます" />
                                                <Button Content="批評空間の作品ページを開く" Click="OpenEgsPage_Click" HorizontalAlignment="Stretch" />
                                                <Button Content="画像を取り直す" Click="ReloadImage_Click" HorizontalAlignment="Stretch"
                                                        ToolTip="保存してある作品の画像を消して、もう一度取得します" />
                                                <Button Content="一覧から削除" Click="Delete_Click" HorizontalAlignment="Stretch" Margin="2,16,2,2" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- 詳細欄をドラッグしている間だけ表示する「置き場所」 -->
                        <Grid x:Name="DropOverlay" Visibility="Collapsed" Background="#01000000">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0.45*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="0.45*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" TextAlignment="Center" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Opacity="0.85" IsHitTestVisible="False"
                                       Text="青い場所以外で離すと、別ウィンドウになり好きな位置に置けます（Esc で取り消し）" />
                            <Border x:Name="DropRight" Grid.Row="0" Grid.Column="1" Tag="Right" Margin="6"
                                    CornerRadius="8" BorderThickness="2" BorderBrush="#904A90E2" Background="#264A90E2" AllowDrop="True"
                                    DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                                <TextBlock Text="ここに置くと&#x0a;右に縦長で表示" TextAlignment="Center" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                            <Border x:Name="DropBottom" Grid.Row="1" Grid.ColumnSpan="2" Tag="Bottom" Margin="6"
                                    CornerRadius="8" BorderThickness="2" BorderBrush="#904A90E2" Background="#264A90E2" AllowDrop="True"
                                    DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                                <TextBlock Text="ここに置くと 下に横長で表示" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ======================= レポートタブ ======================= -->
            <TabItem Header="レポート" x:Name="SummaryTab">
                <DockPanel Margin="12,8">
                    <!-- 期間の選択（1日は 0:00〜23:59。簡易ボタンは今日を含む） -->
                    <WrapPanel DockPanel.Dock="Top" VerticalAlignment="Center">
                        <Button Content="今日" Tag="1" Click="SummaryPreset_Click" ToolTip="今日（0:00〜23:59）" />
                        <Button Content="3日" Tag="3" Click="SummaryPreset_Click" ToolTip="今日を含む直近3日" />
                        <Button Content="1週間" Tag="7" Click="SummaryPreset_Click" ToolTip="今日を含む直近7日" />
                        <Button Content="1か月" Tag="30" Click="SummaryPreset_Click" ToolTip="今日を含む直近1か月" />
                        <Button Content="全期間" Tag="0" Click="SummaryPreset_Click" ToolTip="最初の記録から今日まで" />
                        <TextBlock Text="期間:" VerticalAlignment="Center" Margin="14,0,4,0" />
                        <DatePicker x:Name="SummaryFromPicker" Width="125" SelectedDateChanged="SummaryDate_Changed" />
                        <TextBlock Text="〜" VerticalAlignment="Center" Margin="4,0" />
                        <DatePicker x:Name="SummaryToPicker" Width="125" SelectedDateChanged="SummaryDate_Changed" />
                    </WrapPanel>
                    <!-- 2列目：欄の表示と並べ方（幅が広くても、常にここに表示する） -->
                    <WrapPanel x:Name="SummaryToggleBar" DockPanel.Dock="Top" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="表示:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ToggleButton x:Name="SummaryChartToggle" Content="グラフ" Tag="chart" Click="SummaryPanelToggle_Click" Margin="0,0,4,0" Padding="8,3" />
                        <ToggleButton x:Name="SummaryCalendarToggle" Content="カレンダー" Tag="calendar" Click="SummaryPanelToggle_Click" Margin="0,0,4,0" Padding="8,3" />
                        <ToggleButton x:Name="SummaryGamesToggle" Content="作品" Tag="games" Click="SummaryPanelToggle_Click" Margin="0,0,4,0" Padding="8,3" />
                        <TextBlock Text="並べ方:" VerticalAlignment="Center" Margin="14,0,4,0" />
                        <Button Content="縦に3段" Tag="Rows" Click="SummaryArrange_Click" ToolTip="グラフ・カレンダー・作品を、上から縦に並べます" />
                        <Button Content="横に3列" Tag="Columns" Click="SummaryArrange_Click" ToolTip="グラフ・カレンダー・作品を、左から横に3列で並べます" />
                        <Button Content="初期配置" Tag="Default" Click="SummaryArrange_Click" ToolTip="グラフとカレンダーをメイン、作品を右に戻します" />
                    </WrapPanel>
                    <TextBlock x:Name="SummaryHeadline" DockPanel.Dock="Top" FontSize="15" FontWeight="Bold" Margin="2,10,0,2" />
                    <TextBlock x:Name="SummaryNote" DockPanel.Dock="Top" Opacity="0.7" Margin="2,0,0,6" TextWrapping="Wrap" />
                    <!-- グラフ・カレンダー・作品の3つの欄は、それぞれ メイン／右／下／別ウィンドウ に置ける（ApplySummaryLayout）。最初は全部メインの欄に入れておく -->
                    <Grid>
                        <Grid x:Name="SummaryContentGrid">
                            <ScrollViewer x:Name="SummaryMainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SummaryMainStack">

                                    <!-- ① グラフ -->
                                    <Border x:Name="SummaryChartFrame" BorderBrush="#40808080" BorderThickness="1" Margin="2,2,6,6" SizeChanged="SummaryFrame_SizeChanged">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Tag="chart" Background="#18808080" Padding="10,4" Cursor="SizeAll"
                                                    ToolTip="ドラッグして、メイン・右・下、または好きな場所（別ウィンドウ）に移動できます"
                                                    PreviewMouseLeftButtonDown="SummaryHeader_PreviewMouseLeftButtonDown"
                                                    MouseMove="SummaryHeader_MouseMove" QueryContinueDrag="SummaryHeader_QueryContinueDrag">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" Tag="chart" Click="SummaryPanelHide_Click" Cursor="Arrow"
                                                            ToolTip="この欄を隠す（上の表示ボタンで再表示）" Padding="8,0" />
                                                    <Button DockPanel.Dock="Right" Content="⇄ 場所" Tag="chart" Click="SummaryPanelMove_Click" Cursor="Arrow" Padding="8,0" />
                                                    <TextBlock Text="⠿ プレイ時間のグラフ" VerticalAlignment="Center" FontWeight="Bold" />
                                                </DockPanel>
                                            </Border>
                                            <StackPanel Margin="10,8">
                                                <TextBlock x:Name="SummaryChartTitle" FontWeight="Bold" Margin="0,0,0,4" />
                                                <Border x:Name="SummaryChartBorder" BorderBrush="Gray" BorderThickness="1"
                                                        HorizontalAlignment="Left" Width="300" Height="220">
                                                    <Canvas x:Name="SummaryChart" ClipToBounds="True" Background="Transparent" />
                                                </Border>
                                                <!-- 最も遊んだ日・最長の1回・よく遊ぶ時間帯 -->
                                                <TextBlock x:Name="SummaryHighlights" TextWrapping="Wrap" Margin="2,10,0,0" Opacity="0.85" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- ② カレンダー -->
                                    <Border x:Name="SummaryCalendarFrame" BorderBrush="#40808080" BorderThickness="1" Margin="2,2,6,6">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Tag="calendar" Background="#18808080" Padding="10,4" Cursor="SizeAll"
                                                    ToolTip="ドラッグして、メイン・右・下、または好きな場所（別ウィンドウ）に移動できます"
                                                    PreviewMouseLeftButtonDown="SummaryHeader_PreviewMouseLeftButtonDown"
                                                    MouseMove="SummaryHeader_MouseMove" QueryContinueDrag="SummaryHeader_QueryContinueDrag">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" Tag="calendar" Click="SummaryPanelHide_Click" Cursor="Arrow"
                                                            ToolTip="この欄を隠す（上の表示ボタンで再表示）" Padding="8,0" />
                                                    <Button DockPanel.Dock="Right" Content="⇄ 場所" Tag="calendar" Click="SummaryPanelMove_Click" Cursor="Arrow" Padding="8,0" />
                                                    <TextBlock Text="⠿ カレンダー" VerticalAlignment="Center" FontWeight="Bold" />
                                                </DockPanel>
                                            </Border>
                                            <StackPanel Margin="10,8">
                                                <TextBlock x:Name="SummaryCalendarTitle" FontWeight="Bold" Margin="0,0,0,4" />
                                                <WrapPanel x:Name="SummaryCalendar" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- ③ プレイした作品 -->
                                    <Border x:Name="SummaryGamesFrame" BorderBrush="#40808080" BorderThickness="1" Margin="2,2,6,6">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Tag="games" Background="#18808080" Padding="10,4" Cursor="SizeAll"
                                                    ToolTip="ドラッグして、メイン・右・下、または好きな場所（別ウィンドウ）に移動できます"
                                                    PreviewMouseLeftButtonDown="SummaryHeader_PreviewMouseLeftButtonDown"
                                                    MouseMove="SummaryHeader_MouseMove" QueryContinueDrag="SummaryHeader_QueryContinueDrag">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" Tag="games" Click="SummaryPanelHide_Click" Cursor="Arrow"
                                                            ToolTip="この欄を隠す（上の表示ボタンで再表示）" Padding="8,0" />
                                                    <Button DockPanel.Dock="Right" Content="⇄ 場所" Tag="games" Click="SummaryPanelMove_Click" Cursor="Arrow" Padding="8,0" />
                                                    <TextBlock Text="⠿ プレイした作品" VerticalAlignment="Center" FontWeight="Bold" />
                                                </DockPanel>
                                            </Border>
                                            <StackPanel Margin="10,8,2,2">
                                                <TextBlock x:Name="SummaryEmpty" Text="この期間のプレイ記録はありません" Opacity="0.7" Margin="0,0,0,6" Visibility="Collapsed" />
                                                <ItemsControl x:Name="SummaryGames">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,14,10" Width="{Binding Width}" Cursor="Hand" Background="Transparent"
                                                                  ToolTip="クリックすると、一覧タブでこの作品を開きます"
                                                                  MouseLeftButtonUp="SummaryGameItem_Click">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Text}" Margin="8,0,0,0" Opacity="0.85" />
                                                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="6" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Margin="0,3,0,0" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 左の置き場所（メイン・右と合わせて3カラムにできる） -->
                            <Border x:Name="SummaryLeftBorder" BorderBrush="#40808080" BorderThickness="0,0,1,0">
                                <ScrollViewer x:Name="SummaryLeftScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="SummaryLeftStack" />
                                </ScrollViewer>
                            </Border>
                            <GridSplitter x:Name="SummaryLSplitter" Background="#30808080" ShowsPreview="False" DragCompleted="SummarySplitter_DragCompleted" />
                            <GridSplitter x:Name="SummaryVSplitter" Background="#30808080" ShowsPreview="False" DragCompleted="SummarySplitter_DragCompleted" />
                            <Border x:Name="SummaryRightBorder" BorderBrush="#40808080" BorderThickness="1,0,0,0">
                                <ScrollViewer x:Name="SummaryRightScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="SummaryRightStack" />
                                </ScrollViewer>
                            </Border>

                            <GridSplitter x:Name="SummaryHSplitter" Background="#30808080" ShowsPreview="False" DragCompleted="SummarySplitter_DragCompleted" />
                            <Border x:Name="SummaryBottomBorder" BorderBrush="#40808080" BorderThickness="0,1,0,0">
                                <ScrollViewer x:Name="SummaryBottomScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <UniformGrid x:Name="SummaryBottomStack" Rows="1" />
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- 欄をドラッグしている間だけ表示する「置き場所」 -->
                        <Grid x:Name="SummaryDropOverlay" Visibility="Collapsed" Background="#01000000">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.6*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0.6*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="0.45*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="SummaryDropLeft" Grid.Row="0" Grid.Column="0" Tag="Left" Margin="6"
                                    CornerRadius="8" BorderThickness="2" BorderBrush="#904A90E2" Background="#264A90E2" AllowDrop="True"
                                    DragEnter="SummaryDropZone_DragEnter" DragLeave="SummaryDropZone_DragLeave" DragOver="SummaryDropZone_DragOver" Drop="SummaryDropZone_Drop">
                                <TextBlock Text="ここに置くと&#x0a;左に縦長で表示" TextAlignment="Center" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                            <Border x:Name="SummaryDropMain" Grid.Row="0" Grid.Column="1" Tag="Main" Margin="6"
                                    CornerRadius="8" BorderThickness="2" BorderBrush="#904A90E2" Background="#264A90E2" AllowDrop="True"
                                    DragEnter="SummaryDropZone_DragEnter" DragLeave="SummaryDropZone_DragLeave" DragOver="SummaryDropZone_DragOver" Drop="SummaryDropZone_Drop">
                                <TextBlock Text="ここに置くと メイン（左・中央）に表示" TextAlignment="Center" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                            <Border x:Name="SummaryDropRight" Grid.Row="0" Grid.Column="2" Tag="Right" Margin="6"
                                    CornerRadius="8" BorderThickness="2" BorderBrush="#904A90E2" Background="#264A90E2" AllowDrop="True"
                                    DragEnter="SummaryDropZone_DragEnter" DragLeave="SummaryDropZone_DragLeave" DragOver="SummaryDropZone_DragOver" Drop="SummaryDropZone_Drop">
                                <TextBlock Text="ここに置くと&#x0a;右に縦長で表示" TextAlignment="Center" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                            <Border x:Name="SummaryDropBottom" Grid.Row="1" Grid.ColumnSpan="3" Tag="Bottom" Margin="6"
                                    CornerRadius="8" BorderThickness="2" BorderBrush="#904A90E2" Background="#264A90E2" AllowDrop="True"
                                    DragEnter="SummaryDropZone_DragEnter" DragLeave="SummaryDropZone_DragLeave" DragOver="SummaryDropZone_DragOver" Drop="SummaryDropZone_Drop">
                                <TextBlock Text="ここに置くと 下に横長で表示" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                            <TextBlock Grid.ColumnSpan="3" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,12" Opacity="0.85" IsHitTestVisible="False"
                                       Text="青い場所以外で離すと、別ウィンドウになり好きな位置に置けます（Esc で取り消し）" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ======================= 投稿設定タブ（SNS などに載せる画像を作る） ======================= -->
            <TabItem Header="投稿設定" x:Name="PostTab">
                <DockPanel Margin="12,8">
                    <!-- 最上部（固定）：出力期間と画像出力。この下のレポートエリアだけが画像になる -->
                    <WrapPanel DockPanel.Dock="Top" VerticalAlignment="Center">
                        <TextBlock Text="起点の日:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <DatePicker x:Name="PostStartPicker" Width="125" SelectedDateChanged="PostSetting_Changed" />
                        <TextBlock Text="期間:" VerticalAlignment="Center" Margin="14,0,4,0" />
                        <RadioButton x:Name="PostMonthRadio" Content="1か月" GroupName="PostPeriod" IsChecked="True" VerticalAlignment="Center" Click="PostSetting_Changed" />
                        <RadioButton x:Name="PostYearRadio" Content="1年" GroupName="PostPeriod" VerticalAlignment="Center" Margin="10,0,0,0" Click="PostSetting_Changed" />
                        <TextBlock Text="マイベストブランド:" VerticalAlignment="Center" Margin="14,0,4,0" />
                        <ComboBox x:Name="PostBrandModeBox" Width="150" SelectionChanged="PostSetting_Changed">
                            <ComboBoxItem Content="一番プレイしたブランド" />
                            <ComboBoxItem Content="最高点のブランド" />
                            <ComboBoxItem Content="任意のブランド" />
                        </ComboBox>
                        <ComboBox x:Name="PostBrandBox" Width="170" Margin="4,0,0,0" Visibility="Collapsed" SelectionChanged="PostSetting_Changed" />
                        <TextBlock Text="背景:" VerticalAlignment="Center" Margin="14,0,4,0" />
                        <ComboBox x:Name="PostBackgroundBox" Width="80" SelectionChanged="PostSetting_Changed">
                            <ComboBoxItem Content="明るい" />
                            <ComboBoxItem Content="暗い" />
                        </ComboBox>
                        <CheckBox x:Name="PostExcludeClearedCheck" Content="起点の日より前にクリアした作品を除く" Margin="14,0,0,0" VerticalAlignment="Center" Click="PostSetting_Changed"
                                  ToolTip="プレイした作品の欄から、起点の日より前に終了日がある作品を外します" />
                        <Button x:Name="PostExportButton" Content="画像出力" Margin="14,0,0,0" Padding="14,4" Click="PostExport_Click"
                                ToolTip="下のレポートエリアを、NovelKeeper_年月日.jpg の画像として保存します" />
                    </WrapPanel>
                    <!-- 2列目：レイアウト（カラム数・パネルの追加・初期配置） -->
                    <WrapPanel DockPanel.Dock="Top" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="レイアウト:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="カラム数" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="PostColumnsBox" Width="60" SelectionChanged="PostColumns_Changed">
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                        </ComboBox>
                        <Button x:Name="PostAddButton" Content="＋ パネルを追加" Margin="10,0,0,0" Padding="12,4" Click="PostAdd_Click"
                                ToolTip="パネルを追加します（空いている場所のうち、いちばん上・左に置きます）" />
                        <Button Content="初期配置に戻す" Margin="10,0,0,0" Padding="12,4" Click="PostResetLayout_Click" />
                        <Button Content="デザイン設定" Margin="10,0,0,0" Padding="12,4" Click="PostDesign_Click"
                                ToolTip="背景の色・画像、パネルの色と透過率、フォントと文字色を設定します" />
                    </WrapPanel>
                    <TextBlock x:Name="PostStatus" DockPanel.Dock="Top" Opacity="0.7" Margin="2,6,0,6" />
                    <!-- 全体のデザイン設定（「デザイン設定」ボタンで開く。パネルの設定とは、どちらか一方だけ開く） -->
                    <Border x:Name="PostDesignPanel" DockPanel.Dock="Right" Width="300" Margin="10,0,0,0" Padding="12" Visibility="Collapsed"
                            BorderThickness="1" BorderBrush="#55888888" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="デザイン設定" FontWeight="Bold" FontSize="14" />
                                <TextBlock Text="背景色（#RRGGBB。空欄は、「背景: 明るい / 暗い」の色）" Margin="0,10,0,2" Opacity="0.7" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="PostDesBackColor" Width="110" MaxLength="9" TextChanged="PostDesColor_Changed" Tag="PostDesBackSample" />
                                    <Border x:Name="PostDesBackSample" Width="24" Height="24" Margin="8,0,0,0" BorderBrush="Gray" BorderThickness="1" />
                                </StackPanel>
                                <TextBlock Text="背景の画像" Margin="0,10,0,2" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="画像を選ぶ…" Padding="12,3" Click="PostDesPickImage_Click" />
                                    <Button Content="画像を外す" Padding="12,3" Margin="8,0,0,0" Click="PostDesClearImage_Click" />
                                </StackPanel>
                                <TextBlock x:Name="PostDesImageName" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="パネルの色（#RRGGBB。空欄は標準）" Margin="0,10,0,2" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="PostDesCardColor" Width="110" MaxLength="9" TextChanged="PostDesColor_Changed" Tag="PostDesCardSample" />
                                    <Border x:Name="PostDesCardSample" Width="24" Height="24" Margin="8,0,0,0" BorderBrush="Gray" BorderThickness="1" />
                                </StackPanel>
                                <TextBlock Text="パネルの透過率（すべてのパネルに効きます）" Margin="0,10,0,2" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="PostDesTransparency" Width="190" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" ValueChanged="PostDesTransparency_Changed" />
                                    <TextBlock x:Name="PostDesTransparencyText" Width="46" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                                <TextBlock Text="0% は透かさない、100% は完全に透明です。背景の画像を見せたいときに上げます" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                                <TextBlock Text="フォント（全体）" Margin="0,10,0,2" Opacity="0.7" />
                                <ComboBox x:Name="PostDesFontBox" />
                                <TextBlock Text="文字の色（#RRGGBB。空欄は標準）" Margin="0,10,0,2" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="PostDesTextColor" Width="110" MaxLength="9" TextChanged="PostDesColor_Changed" Tag="PostDesTextSample" />
                                    <Border x:Name="PostDesTextSample" Width="24" Height="24" Margin="8,0,0,0" BorderBrush="Gray" BorderThickness="1" />
                                </StackPanel>
                                <TextBlock x:Name="PostDesError" Foreground="#E5534B" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="適用" Padding="16,4" Click="PostDesApply_Click" />
                                    <Button Content="標準に戻す" Padding="12,4" Margin="8,0,0,0" Click="PostDesReset_Click" />
                                    <Button Content="閉じる" Padding="12,4" Margin="8,0,0,0" Click="PostDesClose_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <!-- パネルの設定（各パネルの ⚙ を押すと開く） -->
                    <Border x:Name="PostSettingsPanel" DockPanel.Dock="Right" Width="300" Margin="10,0,0,0" Padding="12" Visibility="Collapsed"
                            BorderThickness="1" BorderBrush="#55888888" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="パネルの設定" FontWeight="Bold" FontSize="14" />
                                <TextBlock Text="項目" Margin="0,10,0,2" Opacity="0.7" />
                                <ComboBox x:Name="PostSetKindBox" SelectionChanged="PostSetKind_Changed" />
                                <TextBlock Text="タイトル（空欄は、項目の標準の名前）" Margin="0,10,0,2" Opacity="0.7" />
                                <TextBox x:Name="PostSetTitleBox" MaxLength="40" />
                                <TextBlock Text="場所（段・列）と横幅" Margin="0,10,0,2" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="PostSetRowBox" Width="40" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="段目" VerticalAlignment="Center" Margin="4,0,10,0" />
                                    <ComboBox x:Name="PostSetColBox" Width="80" />
                                    <ComboBox x:Name="PostSetSpanBox" Width="100" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="縦幅（1段の高さは決まっています）" Margin="0,10,0,2" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="PostSetRowSpanBox" Width="100" />
                                    <Button Content="中身に合わせる" Margin="8,0,0,0" Padding="10,3" Click="PostSetFit_Click"
                                            ToolTip="いまの設定で、中身が収まる段数を測って入れます（「適用」で反映）" />
                                </StackPanel>
                                <StackPanel x:Name="PostSetItemsGroup">
                                    <TextBlock Text="作品の表示" Margin="0,10,0,2" Opacity="0.7" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="件数" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox x:Name="PostSetCountBox" Width="40" HorizontalContentAlignment="Center" />
                                        <TextBlock Text="列数" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        <ComboBox x:Name="PostSetItemColsBox" Width="60" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="PostSetPriorityGroup">
                                    <TextBlock x:Name="PostSetPickLabel" Text="優先したい作品を選ぶ（未プレイから）" Margin="0,10,0,2" Opacity="0.7" TextWrapping="Wrap" />
                                    <TextBox x:Name="PostSetSearchBox" TextChanged="PostSetSearch_Changed" ToolTip="作品名で絞り込み" />
                                    <ListBox x:Name="PostSetGamesList" Height="190" Margin="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Title}" IsChecked="{Binding Selected, Mode=TwoWay}" Click="PostPick_Click" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel x:Name="PostSetTextGroup">
                                    <TextBlock Text="文章（500文字まで）" Margin="0,10,0,2" Opacity="0.7" />
                                    <TextBox x:Name="PostSetTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxLength="500" VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                                <StackPanel x:Name="PostSetFontGroup">
                                    <TextBlock Text="フォント" Margin="0,10,0,2" Opacity="0.7" />
                                    <ComboBox x:Name="PostSetFontBox" />
                                    <TextBlock Text="色（#RRGGBB。空欄は標準の色）" Margin="0,10,0,2" Opacity="0.7" />
                                    <TextBox x:Name="PostSetColorBox" Width="110" HorizontalAlignment="Left" MaxLength="9" />
                                    <WrapPanel Margin="0,4,0,0" x:Name="PostSetSwatches" />
                                    <TextBlock Text="大きさ（8〜96。空欄は標準）" Margin="0,10,0,2" Opacity="0.7" />
                                    <TextBox x:Name="PostSetFontSizeBox" Width="60" HorizontalAlignment="Left" HorizontalContentAlignment="Center" MaxLength="2" />
                                    <CheckBox x:Name="PostSetPeriodCheck" Content="期間（年月日〜年月日）も表示する" Margin="0,10,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="PostSetTransGroup">
                                    <TextBlock Text="枠の広げ方" Margin="0,10,0,2" Opacity="0.7" />
                                    <CheckBox x:Name="PostSetBleedCheck" Content="画面（画像）の端まで広げる" ToolTip="外すと、ほかのパネルと同じ余白のある枠になります" />
                                    <TextBlock Text="透過率（このパネルだけ）" Margin="0,10,0,2" Opacity="0.7" />
                                    <CheckBox x:Name="PostSetTransFollow" Content="全体の透過率に従う（デザイン設定）" Click="PostSetTransFollow_Click" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Slider x:Name="PostSetTrans" Width="190" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center" ValueChanged="PostSetTrans_Changed" />
                                        <TextBlock x:Name="PostSetTransText" Width="46" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="PostSetError" Foreground="#E5534B" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="適用" Padding="16,4" Click="PostSetApply_Click" />
                                    <Button Content="閉じる" Padding="16,4" Margin="8,0,0,0" Click="PostSetClose_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer x:Name="PostScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ScrollChanged="PostScroll_Changed">
                        <Border x:Name="PostReportHost" Padding="20" VerticalAlignment="Top" HorizontalAlignment="Left" Width="900" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ======================= データ出力タブ ======================= -->
            <TabItem Header="データ出力" x:Name="ExportTab">
                <DockPanel>
                    <!-- サブナビゲーション：書き出す範囲 -->
                    <ListBox x:Name="ExportNav" DockPanel.Dock="Left" Width="170" BorderThickness="0,0,1,0">
                        <ListBoxItem Content="一覧に表示中" Tag="shown" Padding="14,9" />
                        <ListBoxItem Content="全作品" Tag="all" Padding="14,9" />
                        <ListBoxItem Content="バックアップ" Tag="backup" Padding="14,9" />
                    </ListBox>

                    <ScrollViewer x:Name="BackupPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,12" MaxWidth="820" HorizontalAlignment="Left">
                            <TextBlock Text="バックアップ" FontSize="16" FontWeight="Bold" Margin="0,4,0,6" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                       Text="作品の一覧・プレイ時間・評価などの記録（games.db）と、設定（egs_config.json）を、1つの zip ファイルにまとめて書き出します。パソコンの引っ越しや、万一のときの復元に使えます。ログイン情報（ID・パスワード）は含みません。" />
                            <Button Content="バックアップを書き出す…" Click="BackupExport_Click" FontWeight="Bold"
                                    HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,4" />

                            <Separator Margin="0,22,0,14" />
                            <TextBlock Text="バックアップから戻す" FontWeight="Bold" />
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="バックアップファイルの内容に復元します。" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="1." FontWeight="Bold" Margin="0,0,10,8" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap" Text="バックアップファイル（zip）は展開せず、そのまま使います。" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,2,0,0" Text="※「NovelKeeper_backup_日付_時刻.zip」の名称のファイルです。" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="2." FontWeight="Bold" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="「バックアップから戻す…」を押して、その zip を選びます。" />

                                <TextBlock Grid.Row="2" Text="3." FontWeight="Bold" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"
                                           Text="確認画面で、いまの作品数と戻す作品数を確かめて「OK」を押します。" />
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,10,0,0"
                                       Text="※置き換える前に、いまの内容を backups フォルダへ控えとして残します。そのあと、アプリが自動で終了して起動し直します。" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,0"
                                       Text="※ゲームの起動設定は、このパソコンにファイルが見つかるものだけ残します。見つからない作品（別のパソコンへ移したときなど）は、起動設定が外れるので、「ゲーム起動設定」タブで自動検出するか、手動で設定してください。" />
                            <CheckBox x:Name="BackupWithConfig" Margin="0,10,0,0"
                                      Content="設定（列の並び・テーマ・ウィンドウ位置など）も戻す"
                                      ToolTip="別のパソコンのバックアップを戻すときは、フォルダの場所などが合わないことがあるので、オフのままがおすすめです" />
                            <Button Content="バックアップから戻す…" Click="BackupImport_Click"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,4" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ExportPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,12" MaxWidth="820" HorizontalAlignment="Left">
                            <TextBlock x:Name="ExportTitle" FontSize="16" FontWeight="Bold" Margin="0,4,0,6" />
                            <TextBlock x:Name="ExportDescription" TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock x:Name="ExportCount" Margin="0,14,0,0" FontWeight="Bold" />

                            <TextBlock Text="書き出す列" Margin="0,14,0,2" />
                            <TextBlock x:Name="ExportColumns" TextWrapping="Wrap" Opacity="0.7" />
                            <CheckBox x:Name="ExportReviewCheck" Content="感想（一言感想・長文感想）も書き出す" Margin="0,10,0,0"
                                      Click="ExportReviewCheck_Click" />

                            <Button Content="CSVに書き出す…" Click="ExportRun_Click" FontWeight="Bold"
                                    HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,4" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="2,10,0,0"
                                       Text="Excel などで開ける CSV（UTF-8）を書き出します。感想には他の人に見せたくない内容が含まれることがあるので、共有するときは確認してください。" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ======================= ログイン設定タブ ======================= -->
            <TabItem Header="ログイン設定" x:Name="LoginTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,12" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="批評空間のログイン" FontSize="16" FontWeight="Bold" Margin="0,4,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="批評空間のユーザーIDとパスワードを入力して「保存してログイン」を押してください。パスワードは Windows の機能で暗号化して、このPCの中だけに保存します。" />
                        <Grid Margin="0,12,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="ユーザーID" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="LoginUserBox" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="パスワード" VerticalAlignment="Center" />
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="LoginPassBox" Margin="0,2" />
                        </Grid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="LoginSaveButton" Content="保存してログイン" Click="LoginSave_Click" FontWeight="Bold" />
                            <Button Content="ログイン情報を削除" Click="LoginDelete_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="LoginResultText" TextWrapping="Wrap" Margin="2,8,0,0" />
                        <TextBlock x:Name="LoginStateText" Opacity="0.7" Margin="2,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= 批評空間連携タブ ======================= -->
            <TabItem Header="批評空間連携" x:Name="EgsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,12" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="取り込みと同期" FontSize="16" FontWeight="Bold" Margin="0,4,0,6" />
                        <WrapPanel>
                            <Button Content="⇩ 批評空間から一括取り込み…" Click="ImportAll_Click" />
                            <Button Content="⇅ 批評空間と同期" Click="Sync_Click" />
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="2,6,0,0"
                                   Text="・一括取り込み：批評空間に登録している作品を、一覧に追加します。&#x0a;・同期：批評空間の記録（プレイ済・得点・所持・感想など）をツールに取り込みます。ツールで変更して、まだ批評空間に反映していない内容があれば、反映するか確認します。中央値・平均値なども最新になります。" />

                        <TextBlock Text="批評空間へ反映する項目" FontSize="16" FontWeight="Bold" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="作品の詳細欄で「保存」すると、変更した項目だけを批評空間に送ります（詳細欄の「保存時に批評空間へ反映する」に☑があるとき）。変更していない項目や、タグ・音楽・POV などツールにない項目は、批評空間の内容をそのまま残します。" />

                        <TextBlock Text="連携の詳細設定" FontSize="16" FontWeight="Bold" Margin="0,20,0,6" />
                        <Expander Header="批評空間のページの作りが変わったときだけ変更してください">
                            <Grid x:Name="EgsFieldsGrid" Margin="8,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= ゲーム起動設定タブ ======================= -->
            <TabItem Header="ゲーム起動設定" x:Name="LaunchTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,12" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="実行ファイルの自動検出" FontSize="16" FontWeight="Bold" Margin="0,4,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="下のフォルダなどから、作品の実行ファイルをまとめて探して設定します。見つからなかった作品は、一覧の「起動設定」欄にショートカットや exe をドラッグしてください。" />

                        <TextBlock Text="ゲームを入れているフォルダ" Margin="0,12,0,2" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                                <Button Content="追加…" Click="GameFolderAdd_Click" />
                                <Button Content="削除" Click="GameFolderRemove_Click" />
                            </StackPanel>
                            <ListBox x:Name="GameFolderList" Height="100" Width="480" HorizontalAlignment="Left" />
                        </DockPanel>
                        <CheckBox x:Name="ScanSteamCheck" Content="Steam のゲームも探す" Click="LaunchSetting_Changed" Margin="0,6,0,0" />

                        <CheckBox x:Name="UseShortcutsSettingCheck" Content="ショートカットも判定に使う" Click="LaunchSetting_Changed" Margin="0,12,0,0" />
                        <StackPanel Margin="24,4,0,0" IsEnabled="{Binding IsChecked, ElementName=UseShortcutsSettingCheck}">
                            <TextBlock Text="ショートカットを置いているフォルダ（フォルダの直下だけを探します）" Margin="0,0,0,2" />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                                    <Button Content="追加…" Click="ShortcutFolderAdd_Click" />
                                    <Button Content="削除" Click="ShortcutFolderRemove_Click" />
                                </StackPanel>
                                <ListBox x:Name="ShortcutFolderList" Height="90" Width="456" HorizontalAlignment="Left" />
                            </DockPanel>
                            <CheckBox x:Name="ScanStartMenuCheck" Content="スタートメニューのショートカットも探す" Click="LaunchSetting_Changed" Margin="0,6,0,0" />
                        </StackPanel>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="🔍 実行ファイルを自動検出…" Click="AutoDetect_Click" FontWeight="Bold" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= 詳細設定タブ ======================= -->
            <TabItem Header="詳細設定" x:Name="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,12" MaxWidth="820" HorizontalAlignment="Left">

                        <!-- プレイ時間 -->
                        <TextBlock Text="プレイ時間の数え方" FontSize="16" FontWeight="Bold" Margin="0,4,0,6" />
                        <CheckBox x:Name="ExcludeIdleCheck" Content="操作していない時間を除外する" Click="PlaySetting_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="24,4,0,0"
                                    IsEnabled="{Binding IsChecked, ElementName=ExcludeIdleCheck}">
                            <TextBox x:Name="IdleMinutesBox" Width="60" HorizontalContentAlignment="Right" LostFocus="PlaySetting_Changed" />
                            <TextBlock Text="分以上、マウス・キーボードの操作がないときは止める" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="SubtractIdleCheck" Margin="24,6,0,0" Click="PlaySetting_Changed"
                                  IsEnabled="{Binding IsChecked, ElementName=ExcludeIdleCheck}"
                                  Content="止めると判断したとき、操作がなかった分の時間もさかのぼって除く（寝落ち対策）" />
                        <TextBlock Margin="24,2,0,8" TextWrapping="Wrap" Opacity="0.7"
                                   Text="例：15分の設定では、操作がない時間が15分に達した時点で、それまでに数えてしまった15分を差し引きます（操作が戻れば、また数えます）。オート再生で読み進めることが多い場合は、分数を長めにするか、この☑を外してください。ゲームパッドの操作は検知できません。" />
                        <CheckBox x:Name="ForegroundOnlyCheck" Content="ゲームの画面が前面にあるときだけ数える" Click="PlaySetting_Changed" />
                        <TextBlock Margin="24,2,0,0" TextWrapping="Wrap" Opacity="0.7"
                                   Text="最小化していたり、ほかの画面の裏に回っていたりする間は数えません。" />

                        <!-- 常駐と起動 -->
                        <TextBlock Text="常駐と起動" FontSize="16" FontWeight="Bold" Margin="0,20,0,6" />
                        <CheckBox x:Name="CloseToTrayCheck" Content="閉じるボタンで終了せず、タスクバー右下に常駐する" Click="PlaySetting_Changed" />
                        <CheckBox x:Name="AutoStartCheck" Content="Windows の起動時に、常駐した状態で自動で起動する" Click="PlaySetting_Changed" Margin="0,6,0,0" />
                        <CheckBox x:Name="NotifyCheck" Content="プレイ時間の計測の開始・終了を通知する" Click="PlaySetting_Changed" Margin="0,6,0,0" />
                        <CheckBox x:Name="AlwaysAdminCheck" Content="すべての作品を、常に管理者権限で起動する ※" Click="PlaySetting_Changed" Margin="0,12,0,0" />
                        <TextBlock Margin="24,2,0,0" TextWrapping="Wrap" Opacity="0.7"
                                   Text="起動のたびに、Windows の確認画面（ユーザーアカウント制御）が出ます。&#10;※ Steam・DMM Game Player など URL 形式の起動は、管理者権限にできません（通常権限で起動します）。&#10;作品ごとの設定は、一覧の「起動設定」欄を右クリックして行えます。" />
                        <StackPanel Orientation="Horizontal" Margin="24,6,0,0">
                            <Button x:Name="ClearAdminButton" Content="管理者権限の設定を、すべての作品から外す…" Click="ClearAdmin_Click" />
                            <TextBlock x:Name="AdminCountText" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7" />
                        </StackPanel>

                        <!-- 表示 -->
                        <TextBlock Text="表示" FontSize="16" FontWeight="Bold" Margin="0,20,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="テーマ" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ThemeBox" Width="160" HorizontalAlignment="Left" Margin="0,2"
                                      SelectionChanged="ThemeBox_SelectionChanged">
                                <ComboBoxItem Content="ダーク" Tag="Dark" />
                                <ComboBoxItem Content="ライト" Tag="Light" />
                                <ComboBoxItem Content="PCに合わせる" Tag="System" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="詳細欄" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DetailPositionBox" Width="220" HorizontalAlignment="Left" Margin="0,2"
                                      SelectionChanged="DetailPositionBox_SelectionChanged">
                                <ComboBoxItem Content="右に縦長で表示" Tag="Right" />
                                <ComboBoxItem Content="下に横長で表示" Tag="Bottom" />
                                <ComboBoxItem Content="別ウィンドウで表示" Tag="Float" />
                                <ComboBoxItem Content="表示しない" Tag="Hidden" />
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="購入前の作品" VerticalAlignment="Center" />
                            <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                                <CheckBox x:Name="ShowBeforePurchaseCheck" Content="一覧に表示する（購入予定など）" Margin="0,0,16,0" VerticalAlignment="Center"
                                          Checked="ShowBeforePurchase_Changed" Unchecked="ShowBeforePurchase_Changed"
                                          ToolTip="発売済みで購入確認が必要な作品は、オフでも一覧に出します" />
                                <Button Content="購入前の作品を整理…" Click="CleanupBeforePurchase_Click"
                                        ToolTip="購入前の作品を、批評空間（購入予定を「ー」にして記録を消す）とツールの一覧の両方から外します" />                            </WrapPanel>
                            <TextBlock Grid.Row="4" Text="作品の画像" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <CheckBox x:Name="ShowImagesCheck" Content="詳細欄に表示する" VerticalAlignment="Center"
                                          Checked="ShowImages_Changed" Unchecked="ShowImages_Changed" />
                                <Button Content="保存した画像をすべて削除" Click="ClearImages_Click" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="一覧の表示倍率" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Width="50" />
                                <Button Content="100% に戻す" Click="ResetZoom_Click" />
                                <TextBlock Text="（一覧の上で Ctrl＋マウスホイールでも変えられます）" Opacity="0.7" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- 一覧の列 -->
                        <TextBlock Text="一覧の列" FontSize="16" FontWeight="Bold" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="2,0,0,4"
                                   Text="☑ を付けた列を表示します。↑↓ で並び順を変えられます（一覧の見出しをドラッグしても変えられます）。タイトル・ブランド・状態・プレイ時間・起動設定は常に表示します。批評空間の項目（平均値・感想など）を追加できます。一覧を右クリックしても切り替えられます。" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                                <Button Content="↑" Click="ColumnUp_Click" Width="40" />
                                <Button Content="↓" Click="ColumnDown_Click" Width="40" />
                                <Button Content="初期状態" Click="ColumnReset_Click" />
                            </StackPanel>
                            <ListBox x:Name="ColumnList" Height="260" Width="320" HorizontalAlignment="Left">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Visible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanHide}" Click="ColumnCheck_Click" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- データ -->
                        <TextBlock Text="データ" FontSize="16" FontWeight="Bold" Margin="0,20,0,6" />
                        <WrapPanel>
                            <Button Content="データの保存フォルダを開く" Click="OpenDataFolder_Click" />
                            <Button Content="連携設定ファイルを開く（上級者向け）" Click="OpenConfig_Click" />
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="2,4,0,0"
                                   Text="作品の一覧・プレイ時間・設定・ログイン情報は、このフォルダに保存されます。自動バックアップ（backups）や、エラーの記録（log.txt）もここにあります。バックアップは「データ出力」タブの「バックアップ」から行ってください（ログイン情報は含みません）。" />
                        <TextBlock x:Name="VersionText" Opacity="0.7" Margin="2,12,0,20" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
