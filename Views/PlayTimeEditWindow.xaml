<Window x:Class="NovelKeeper.Views.PlayTimeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プレイ時間の補正" Width="560" Height="460" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="TotalText" Margin="0,4,0,0" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,4,0,8"
                       Text="計測し忘れた分を追加したり、まちがった記録を直したり、消したりできます。「手動」は、ここで追加・編集した記録です。" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="閉じる" IsCancel="True" IsDefault="True" Width="80" />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="＋ 追加…" Click="Add_Click" />
            <Button Content="編集…" Click="Edit_Click" />
            <Button Content="削除" Click="Delete_Click" />
        </WrapPanel>

        <DataGrid x:Name="SessionGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  MouseDoubleClick="SessionGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="開始" Binding="{Binding StartText}" Width="130" />
                <DataGridTextColumn Header="終了" Binding="{Binding EndText}" Width="130" />
                <DataGridTextColumn Header="時間" Binding="{Binding DurationText}" Width="100" />
                <DataGridTextColumn Header="種別" Binding="{Binding KindText}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
