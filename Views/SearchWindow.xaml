<Window x:Class="ErogeLauncher.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批評空間から作品を追加" Height="520" Width="820"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" x:Name="SearchButton" Content="検索" Click="Search_Click" IsDefault="True" />
            <TextBox x:Name="KeywordBox" VerticalContentAlignment="Center" FontSize="14" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="閉じる" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="選択した作品を追加" Click="Add_Click" FontWeight="Bold" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.7"
                       Text="タイトルの一部を入力して検索（Ctrl / Shift で複数選択できます）" />
        </DockPanel>

        <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="ブランド" Binding="{Binding Brand}" Width="160" />
                <DataGridTextColumn Header="発売日" Binding="{Binding SellDay}" Width="95" />
                <DataGridTextColumn Header="中央値" Binding="{Binding Median}" Width="55" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
